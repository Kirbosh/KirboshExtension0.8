{
    "name": "kirboshs-extensions-0.8",
    "version": "1.0.2",
    "private": true,
    "repositoryName": "Kirbosh’s Extensions (0.8)",
    "description": "A focused Paperback 0.8 repository for Western comics.",
    "baseURL": "https://kirbosh.github.io/KirboshExtension0.8/0.8-stable",
    "scripts": {
        "bundle": "paperback bundle",
        "prebuild": "node -e \"require('node:fs').mkdirSync('bundles', { recursive: true })\"",
        "build": "paperback bundle --folder=0.8-stable && node scripts/enhance-site.cjs bundles/0.8-stable",
        "serve": "paperback serve --port 3002",
        "test": "tsc -p tests/tsconfig.json && node --test .test-output/tests/KirboshBatCaveParser.test.js",
        "test:device": "paperback test KirboshBatCave",
        "typecheck": "tsc --noEmit",
        "lint": "eslint --ext .ts src tests",
        "format": "prettier --write \"{src,tests,scripts}/**/*.{ts,cjs}\" \"*.{json,md}\" \".github/workflows/*.yml\"",
        "format:check": "prettier --check \"{src,tests,scripts}/**/*.{ts,cjs}\" \"*.{json,md}\" \".github/workflows/*.yml\"",
        "verify:bundle": "node scripts/verify-bundle.cjs bundles/0.8-stable",
        "ci": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run verify:bundle"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Kirbosh/KirboshExtension0.8.git"
    },
    "author": "Kirbosh, based on work by Karrot and contributors",
    "license": "GPL-3.0-or-later",
    "devDependencies": {
        "@tsconfig/recommended": "1.0.8",
        "@types/node": "18.19.130",
        "@typescript-eslint/eslint-plugin": "5.62.0",
        "@typescript-eslint/parser": "5.62.0",
        "eslint": "7.32.0",
        "eslint-plugin-modules-newline": "0.0.6",
        "prettier": "2.8.8",
        "typescript": "4.9.5"
    },
    "dependencies": {
        "@paperback/toolchain": "0.8.7",
        "@paperback/types": "0.8.7",
        "cheerio": "1.0.0"
    }
}
